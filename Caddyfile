:{$PORT} {
    # 1. Atrapa /chat y /chat/ (usamos handle_path para limpiar la ruta)
    handle_path /chat* {
        reverse_proxy https://whaticket-community-production-d61c.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }
    
    # 2. Los archivos visuales, js y audios
    handle /assets/* {
        reverse_proxy https://whaticket-community-production-d61c.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }

    # 3. La API (Atrapa /wtapi y /wtapi/)
    handle_path /wtapi* {
        reverse_proxy https://whaticket-community-production-d61c.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }

    # 4. Los WebSockets
    handle /socket.io/* {
        reverse_proxy https://whaticket-community-production-d61c.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }

    # 5. Todo lo demás va a EspoCRM
    handle /* {
        reverse_proxy https://espocrm-production-6061.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }
}