:{$PORT} {
    # 1. El iframe principal del chat
    handle /chat/* {
        reverse_proxy https://whaticket-community-production-d61c.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }
    
    # 2. Los archivos visuales y sonidos de WhaTicket (Acá arreglamos el error del archivo "howler.js")
    handle /assets/* {
        reverse_proxy https://whaticket-community-production-d61c.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }

    # 3. EL CARRIL EXCLUSIVO PARA LA API
    handle_path /wtapi/* {
        reverse_proxy https://whaticket-community-production-d61c.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }

    # 4. Los WebSockets (Conexión en tiempo real)
    handle /socket.io/* {
        reverse_proxy https://whaticket-community-production-d61c.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }

    # 5. Todo lo demás va a EspoCRM
    handle /* {
        reverse_proxy https://espocrm-production-6061.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }
}