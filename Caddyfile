:{$PORT} {
    # 1. FRONTEND: La pantalla visual
    handle_path /chat* {
        reverse_proxy https://dynamic-simplicity-production-a986.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }
    handle /assets/* {
        reverse_proxy https://dynamic-simplicity-production-a986.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }

    # 2. BACKEND API: Forzamos a que NO use caché (Chau problemas de 304)
    handle_path /wtapi* {
        reverse_proxy https://whaticket-community-production-d61c.up.railway.app {
            header_up Host {upstream_hostport}
            
            # Estas cabeceras obligan al navegador a pedir datos reales siempre, ignorando el 304
            header_down Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
            header_down Pragma "no-cache"
            header_down Expires "0"
        }
    }

    # 3. WEBSOCKETS: Configuración pesada para que no se cuelguen en Railway
    handle /socket.io/* {
        reverse_proxy https://whaticket-community-production-d61c.up.railway.app {
            header_up Host {upstream_hostport}
            header_up Upgrade {http.request.header.Upgrade}
            header_up Connection {http.request.header.Connection}
        }
    }

    # 4. CRM: Todo lo demás va a EspoCRM
    handle /* {
        reverse_proxy https://espocrm-production-6061.up.railway.app {
            header_up Host {upstream_hostport}
        }
    }
}